      "entrypoint": "tb/axi_ram/Makefile",
      "cwd": "tb/axi_ram",
      "driver": "make",
      "argv": [
        "make",
        "SIM=icarus",
        "WAVES=0"
      ],
      "simulator": "icarus",
      "environment_profile": "cocotb1",
      "requirements": {
        "tools": [
          "make",
          "iverilog",
          "vvp"
        ],
        "python_modules": [
          "cocotb",
          "cocotb_test",
          "pytest",
          "cocotbext.axi"
        ]
      },
      "expected": {
        "kind": "junit",
        "paths": [
          "tb/axi_ram/results.xml"
        ],
        "minimum_tests": 25,
        "allow_skips": false
