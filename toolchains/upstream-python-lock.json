{
  "schema_version": 1,
  "description": "Exact dependencies for running original pinned upstream verification entrypoints. The profiles are separate from the default VWB toolchain Python environment.",
  "platform": "linux-x86_64",
  "python": "CPython 3.11 supplied by the pinned OSS CAD Suite",
  "profiles": {
    "cocotb1": {
      "description": "Original upstream Cocotb 1.x and MyHDL benches",
      "python": {
        "implementation": "cpython",
        "version": "3.11",
        "abi": "cp311",
        "platform": "linux-x86_64"
      },
      "packages": [
        "cocotb",
        "cocotb-bus",
        "cocotb-test",
        "cocotbext-axi",
        "cocotbext-uart",
        "find-libpython",
        "iniconfig",
        "myhdl",
        "packaging",
        "pluggy",
        "pytest",
        "scapy"
      ],
      "build_packages": [
        "setuptools",
        "wheel"
      ],
      "native_builds": [
        {
          "id": "myhdl-icarus-vpi",
          "cwd": "site/share/myhdl/cosimulation/icarus",
          "argv": [
            "make"
          ],
          "outputs": [
            "myhdl.vpi"
          ],
          "tools": [
            "make",
            "iverilog-vpi",
            "gcc"
          ],
          "environment": {
            "IVERILOG_VPI_MODULE_PATH": "${profile}/site/share/myhdl/cosimulation/icarus"
          }
        }
      ]
    },
    "fusesoc": {
      "description": "Original FuseSoC/Edalize project targets",
      "python": {
        "implementation": "cpython",
        "version": "3.11",
        "abi": "cp311",
        "platform": "linux-x86_64"
      },
      "packages": [
        "argcomplete",
        "attrs",
        "edalize",
        "fastjsonschema",
        "fusesoc",
        "jinja2",
        "markupsafe",
        "okonomiyaki",
        "pyparsing",
        "pyyaml",
        "simplesat",
        "six"
      ]
    }
  },
